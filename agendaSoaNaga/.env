# AgendaSOA Service Configuration
AGENDA_SOA_HOST=https://agasoa.mpsa.com/

AGENDA_SOA_USERNAME=mwpaga0a
AGENDA_SOA_PASSWORD=sLq9kb6L


# Certificato client mTLS: id dei segreti su AWS Secrets Manager (via Secrets Extension)
AGENDA_SOA_CERT_SECRET_ID=apicCert
AGENDA_SOA_KEY_SECRET_ID=apicKey
# Porta locale su cui la AWS Parameters and Secrets Lambda Extension espone la cache HTTP
PARAMETERS_SECRETS_EXTENSION_HTTP_PORT=2773
# Token di sessione usato come header X-Aws-Parameters-Secrets-Token verso la Extension.
# In Lambda è iniettato dal runtime; in locale valorizzare con il token della sessione AWS attiva.
AWS_SESSION_TOKEN=

# Static API-Key used by appointment endpoint
AGENDA_SOA_API_KEY=6FB19E02E3A145A9A10E71AC2AE526FC

