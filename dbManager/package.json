{
  "name": "dbmanager",
  "version": "1.0.0",
  "description": "Configurazioni pacchetti (HQ_PKCONFIG) per mercato/brand — Aurora PostgreSQL",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "test": "jest --testEnvironment=node",
    "test:coverage": "jest --testEnvironment=node --coverage --ci --outputFile=coverage/jest-results.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "PkConfigRepository.js",
      "ConfigPackagesRepository.js",
      "AnagSnowflakesRepository.js",
      "HqRepository.js",
      "db.js",
      "index.js"
    ],
    "coverageReporters": [
      "html",
      "text",
      "lcov",
      "json-summary",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./coverage",
          "filename": "test-report.html",
          "openReport": false,
          "includeConsoleLog": true,
          "includeFailureMsg": true,
          "expand": true
        }
      ]
    ]
  }
}
