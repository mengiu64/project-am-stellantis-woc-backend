# moparDoc — variabili d'ambiente per l'esecuzione LOCALE (CLI / test manuali).
# In Lambda le credenziali sono lette da SSM/Secrets Manager tramite MOPARDOC_PARAM_NAME
# (v. config.js / secretsLoader.js) e le MOPARDOC_DB_* arrivano da template.yaml.

# PingFederate — client dedicato moparDoc (scope prd:mdo)
MOPARDOC_PING_CLIENT_ID=your_ping_client_id_here
MOPARDOC_PING_CLIENT_SECRET=your_ping_client_secret_here

# IBM API Connect (X-IBM-Client-Id / X-IBM-Client-Secret)
MOPARDOC_IBM_CLIENT_ID=your_ibm_client_id_here
MOPARDOC_IBM_CLIENT_SECRET=your_ibm_client_secret_here

# Codici di accesso job-docs (APIAccessCode / TAMAccessCode)
MOPARDOC_API_ACCESS_CODE=your_api_access_code_here
MOPARDOC_TAM_ACCESS_CODE=your_tam_access_code_here

# Solo in Lambda: nome del parametro SSM con le credenziali (in locale lasciare vuoto)
# MOPARDOC_PARAM_NAME=/app/np-BSN0027990-dev/mopardoc_ibm

# Override opzionali del gateway MoparDocs Services
# MOPARDOCS_SERVICES_BASE_URL=https://api-oidc-preprod.groupe-psa.com
# MOPARDOCS_SERVICES_PATH=/job-docs/connector/v1

# Cache token PingFederate su DynamoDB (opzionale in locale)
# DYNAMO_CACHE_TABLE_NAME=your_dynamo_table_here

# Aurora PostgreSQL "wiadvisor" (woc.mopardoc_inspection_media, metadati di ispezione foto).
# OPZIONALE: se MOPARDOC_DB_HOST e' vuota i metadati non vengono salvati/letti (metadataSaved=false, InspectionMetadata=null)
MOPARDOC_DB_HOST=your_rds_proxy_endpoint_here
# In Lambda user/password arrivano dal secret (MOPARDOC_DB_SECRET_ID); in locale si possono passare direttamente
MOPARDOC_DB_SECRET_ID=sm-np-bsn0027990-dev-aurora-app
# MOPARDOC_DB_USER=wiadvisor_app
# MOPARDOC_DB_PASSWORD=your_db_password_here
# MOPARDOC_DB_PORT=5432
# MOPARDOC_DB_NAME=wiadvisor
# MOPARDOC_DB_SSL=true
# PARAMETERS_SECRETS_EXTENSION_HTTP_PORT=2773