# Endpoint host del database (RDS Proxy consigliato per le Lambda, non l'endpoint
# diretto del cluster Aurora)
DMLCONFIGSYNC_DB_HOST=rdsproxy-np-bsn0027990-dev.proxy-cx8ouka2knxb.eu-west-1.rds.amazonaws.com

# Opzionali: se assenti vengono ricavati dal secret Secrets Manager (vedi sotto)
DMLCONFIGSYNC_DB_PORT=5432
DMLCONFIGSYNC_DB_NAME=wiadvisor
# In locale, se non si ha accesso all'estensione Secrets Manager, si possono
# passare user/password direttamente (solo per sviluppo/test, MAI in produzione):
DMLCONFIGSYNC_DB_USER=
DMLCONFIGSYNC_DB_PASSWORD=

# Secrets Manager secret id con le credenziali least-privilege dell'utente
# applicativo Aurora ("wiadvisor_app"), recuperato tramite la AWS Parameters and
# Secrets Lambda Extension
DMLCONFIGSYNC_DB_SECRET_ID=sm-np-bsn0027990-dev-aurora-app

# Impostare a "false" solo per test locali contro un Postgres senza TLS
DMLCONFIGSYNC_DB_SSL=true

# ── dms/config.js (in-process, richiesto via cross-folder require) ──────────
# Stesse credenziali usate da dms/settings, pkFavorite, session per il gateway DML
DMS_PING_CLIENT_ID=
DMS_PING_CLIENT_SECRET=
DML_IBM_CLIENT_ID=
DML_IBM_CLIENT_SECRET=
DML_X_TARGET_ENV=stage
