# Bucket S3 dove risiede il file dei dati di sessione (obbligatoria)
SESSION_BUCKET_NAME=s3-np-bsn0027990-dev-translations

# Key dell'oggetto S3 con i dati di sessione (opzionale, default: session/session_data.json)
SESSION_DATA_KEY=session/session_data.json

# Mercato di default (4 caratteri) quando non viene passato codmarket (opzionale, default: 1000)
SESSION_DEFAULT_MARKET=1000

# REST interno privato IAM SigV4; credenziali dalla catena AWS standard
WOC_INTERNAL_API_URL=https://<private-api-id>.execute-api.eu-west-1.amazonaws.com/wia
WOC_INTERNAL_TIMEOUT_MS=25000
AWS_REGION=eu-west-1

# Cache locale dei dati/context di sessione
DYNAMO_CACHE_TABLE_NAME=<tmp-cache-table-name>
SESSION_CONTEXT_CACHE_TTL_MS=300000
