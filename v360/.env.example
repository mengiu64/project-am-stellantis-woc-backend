# PingFederate credentials (dedicato v360)
V360_PING_CLIENT_ID=your_ping_client_id_here
V360_PING_CLIENT_SECRET=your_ping_client_secret_here

# Stellantis ASV360 API credentials (X-IBM-Client-Id / X-IBM-Client-Secret)
ASV_CLIENT_ID=your_asv_client_id_here
ASV_CLIENT_SECRET=your_asv_client_secret_here

# Client identifier usato di default nel body di getdetails (specifico per ambiente)
ASV_GETDETAILS_CLIENT_ID=your_asv_getdetails_client_id_here

# Bucket S3 con le anagrafiche statiche (brandowner.json, energytype.json)
CONFIG_BUCKET_NAME=your_config_bucket_name_here
# Prefisso della key S3 ({prefix}/brandowner.json, {prefix}/energytype.json)
CONFIG_KEY_PREFIX=config
