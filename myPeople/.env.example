# myPeople API host (preprod / prod gateway)
MYPEOPLE_HOST=https://api-basic-preprod.groupe-psa.com
# Base path of the myPeople/IURSMA service (without the final action, e.g. readUserProfiles)
MYPEOPLE_BASE_PATH=/applications/mypeople/iursma/v1

# API Connect gateway credentials
MYPEOPLE_IBM_CLIENT_ID=your_ibm_client_id_here

# Basic Auth credentials
MYPEOPLE_USERNAME=your_username_here
MYPEOPLE_PASSWORD=your_password_here

# Identifier costante della richiesta (non varia per utente, non più un parametro di input)
MYPEOPLE_IDENTIFIER=your_identifier_here

# (optional) Secrets Manager secret IDs holding the mTLS client certificate/key,
# retrieved at runtime via the AWS Parameters and Secrets Lambda Extension
MYPEOPLE_CERT_SECRET_ID=apicCert
MYPEOPLE_KEY_SECRET_ID=apicKey
