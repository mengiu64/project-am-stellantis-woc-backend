# Identificativo del cluster Aurora da avviare. In Lambda viene impostato
# automaticamente da template.yaml tramite
# !Sub "rds-np-bsn0027990-${Environment}-aurora": valorizzare qui solo per
# test/esecuzione locale da riga di comando (node index.js).
AURORAAUTOSTART_DB_CLUSTER_IDENTIFIER=rds-np-bsn0027990-stage-aurora

# Regione AWS del cluster (in Lambda è già impostata automaticamente da AWS
# tramite AWS_REGION; necessaria solo in locale se non già configurata via
# `aws configure` / variabili d'ambiente AWS standard).
AWS_REGION=eu-west-1
