{
  "name": "jobcard",
  "version": "1.0.0",
  "description": "JobCard lambda - PingFederate auth + Stellantis DGT API client",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "list": "node index.js list",
    "details": "node index.js details",
    "test": "jest --testEnvironment=node",
    "test:coverage": "jest --testEnvironment=node --coverage --ci --outputFile=coverage/jest-results.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/lib-dynamodb": "^3.1131.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "authService.js",
      "httpClient.js",
      "jobCardService.js",
      "dynamoCache.js"
    ],
    "coverageReporters": [
      "html",
      "text",
      "lcov",
      "json-summary",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./coverage",
          "filename": "test-report.html",
          "openReport": false,
          "includeConsoleLog": true,
          "includeFailureMsg": true,
          "expand": true
        }
      ]
    ]
  }
}
