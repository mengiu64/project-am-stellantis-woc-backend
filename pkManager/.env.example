# API REST privata IAM SigV4; le credenziali AWS provengono dal ruolo/provider chain.
# In AWS solo il riferimento: WOC_INTERNAL_CONFIG_SECRET_ID=sm-np-bsn0027990-dev-internal-api-config
# URL e timeout sottostanti sono per locale o JSON del secret condiviso.
WOC_INTERNAL_API_URL=https://<private-api-id>.execute-api.eu-west-1.amazonaws.com/wia
AWS_REGION=eu-west-1
WOC_INTERNAL_TIMEOUT_MS=25000
PK_DETAIL_FETCH_CONCURRENCY=1

# Configurazione runtime AWS: usare il solo riferimento, non i default sottostanti.
# WOC_CONFIG_SECRET_ID=sm-np-bsn0027990-dev-pkmanager-config
# Default di dominio per .env locale o JSON del secret; non credenziali upstream.
EPER_CODDEALER=
EPER_CODMARKET=
EPER_LINGUA=IT
DOCSOA_CODBRAND=
DOCSOA_LDP=
DOCSOA_LANGUE=
DOCSOA_PAYS=
DOCSOA_CODEPDV=
MP_LANGUAGE_CODE=
MP_COUNTRY_CODE=
MP_DEALER_IDENTIFICATION_CODE=
MP_MANUFACTURER=
