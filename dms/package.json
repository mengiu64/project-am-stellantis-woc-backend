{
  "name": "dms",
  "version": "1.0.0",
  "description": "DMS lambda - PingFederate auth + Stellantis DML API client",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "settings": "node index.js settings",
    "test": "jest --testEnvironment=node",
    "test:coverage": "jest --testEnvironment=node --coverage --ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "authService.js",
      "dmsService.js",
      "httpClient.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
