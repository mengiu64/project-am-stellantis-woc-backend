# Configurazione propria di synch-status
ENVIRONMENT=dev
AWS_REGION=eu-west-1
LOG_LEVEL=info

# Aurora PostgreSQL (parametri SSM con ARN del secret e endpoint RDS Proxy)
DB_SECRET_ARN_PARAM=/your/synch-status/db-secret-arn
RDS_PROXY_ENDPOINT_PARAM=/your/synch-status/rds-proxy-endpoint

# REST privato tra servizi (AWS_IAM / SigV4; token DGT gestito dal servizio jobcard)
WOC_INTERNAL_API_URL=https://<private-api-id>.execute-api.eu-west-1.amazonaws.com/wia
WOC_INTERNAL_TIMEOUT_MS=25000
